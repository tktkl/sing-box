#!/usr/bin/env bash
set -Eeuo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
version=$(cat VERSION)
[[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { printf 'Invalid release version\n' >&2; exit 1; }
temporary=$(mktemp -d)
trap 'rm -rf -- "$temporary"' EXIT
mkdir -p "$temporary/sb-manager-$version" .test-output/releases
for path in bin lib jq scripts docs VERSION dependencies.lock.json install.sh LICENSE README.md; do cp -a "$path" "$temporary/sb-manager-$version/$path"; done
archive=".test-output/releases/sb-manager-$version.tar.gz"
tar -czf "$archive" -C "$temporary" "sb-manager-$version"
cp install.sh .test-output/releases/install.sh
(
    cd .test-output/releases
    if command -v sha256sum >/dev/null; then
        sha256sum "sb-manager-$version.tar.gz" > "sb-manager-$version.tar.gz.sha256"
        sha256sum "sb-manager-$version.tar.gz" install.sh > SHA256SUMS
    else
        shasum -a 256 "sb-manager-$version.tar.gz" > "sb-manager-$version.tar.gz.sha256"
        shasum -a 256 "sb-manager-$version.tar.gz" install.sh > SHA256SUMS
    fi
)
printf '%s\n' "$archive"
