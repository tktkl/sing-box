#!/usr/bin/env bash
set -Eeuo pipefail
if (( BASH_VERSINFO[0] < 5 )); then
    printf 'sb requires Bash 5 or later.\n' >&2
    exit 1
fi
SB_HOME=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
export SB_HOME
for module in common links render service state certificates nodes maintenance install import cli; do
    # All sourced files belong to the installed, root-owned release.
    source "$SB_HOME/lib/$module.sh"
done
main "$@"
